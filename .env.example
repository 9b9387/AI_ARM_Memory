# 复制为 .env 后，先启动 Qdrant 与 Neo4j（见 README 二、运行方式），再在项目根执行: python main.py
# 对话→结构化抽取由调用方在项目外完成，本服务仅接收 extraction 并写入（apply_extraction）
# -----------------------------------------------------------------------------
# 本地路径（相对项目根；首次运行会自动创建 data 目录）
# -----------------------------------------------------------------------------
ARM_DATA_DIR=./data/arm_memory
ARM_SQLITE_PATH=./data/arm_memory/arm_memory.db
ARM_POLICIES_DIR=./policies
COMPANION_PROFILE_PATH=./personas/companion_profile.md
ARM_COMPANION_NODE_NAME=companion:self
# -----------------------------------------------------------------------------
# Qdrant（必选，默认本地 6333）
# 启动: docker run -d --name qdrant -p 6333:6333 qdrant/qdrant
# -----------------------------------------------------------------------------
ARM_QDRANT_URL=http://127.0.0.1:6333
ARM_QDRANT_COLLECTION=arm_memory
# -----------------------------------------------------------------------------
# Neo4j（必选，默认本地 7474，密码与 docker -e NEO4J_AUTH 一致）
# 启动: docker run -d --name neo4j -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/your-password neo4j:latest
# -----------------------------------------------------------------------------
ARM_NEO4J_URL=http://127.0.0.1:7474
ARM_NEO4J_USER=neo4j
ARM_NEO4J_PASSWORD=your-password
ARM_NEO4J_DATABASE=neo4j
# -----------------------------------------------------------------------------
# Embedding（默认 MLX 本地模型；首次会拉取模型）
# 使用远程 API 时改为 provider=openai 并填 ARM_EMBEDDING_BASE_URL / ARM_EMBEDDING_API_KEY
# -----------------------------------------------------------------------------
ARM_EMBEDDING_PROVIDER=mlx
ARM_EMBEDDING_MODEL=mlx-community/Qwen3-Embedding-0.6B-mxfp8
ARM_EMBEDDING_BASE_URL=
ARM_EMBEDDING_API_KEY=
ARM_EMBEDDING_TIMEOUT=120
ARM_EMBEDDING_BATCH_SIZE=16
ARM_EMBEDDING_MAX_LENGTH=512
# 本地模型：ARM_EMBEDDING_MODEL_PATH 指向已下载的模型目录则直接从该路径加载，不下载
# 下载缓存：ARM_EMBEDDING_CACHE_DIR 不填时默认使用 ARM_DATA_DIR/embedding_cache
ARM_EMBEDDING_MODEL_PATH=./models
ARM_EMBEDDING_CACHE_DIR=
# -----------------------------------------------------------------------------
# 检索与画像（一般无需改）
# -----------------------------------------------------------------------------
ARM_RETRIEVAL_TOP_K=6
ARM_WORKING_MEMORY_TURNS=12
ARM_USER_MANUAL_MEMORY_LIMIT=12
ARM_VECTOR_DIMENSIONS=1024
ARM_PROFILE_ITEM_LIMIT_PER_FACET=24
ARM_PROFILE_ITEM_STALE_DAYS=180
ARM_RETRIEVAL_WEIGHT_SEMANTIC=0.40
ARM_RETRIEVAL_WEIGHT_LEXICAL=0.15
ARM_RETRIEVAL_WEIGHT_GRAPH=0.20
ARM_RETRIEVAL_WEIGHT_SALIENCE=0.15
ARM_RETRIEVAL_WEIGHT_REMOTE=0.10
ARM_RETRIEVAL_CANDIDATE_LIMIT=300
ARM_RETRIEVAL_QDRANT_PREFETCH_FACTOR=2
# -----------------------------------------------------------------------------
# 记忆生命周期（一般无需改）
# -----------------------------------------------------------------------------
ARM_EPISODIC_HALF_LIFE_HOURS=168
ARM_SEMANTIC_HALF_LIFE_HOURS=2160
ARM_RECONSOLIDATION_BOOST=1.15
ARM_MEMORY_ARCHIVE_MIN_AGE_DAYS=90
ARM_MEMORY_ARCHIVE_MIN_SALIENCE=0.20
ARM_MEMORY_MERGE_SIMILARITY_THRESHOLD=0.85
# -----------------------------------------------------------------------------
# 服务监听
# -----------------------------------------------------------------------------
ARM_SERVICE_HOST=127.0.0.1
ARM_SERVICE_PORT=8788
ARM_SERVICE_WS_PATH=/ws